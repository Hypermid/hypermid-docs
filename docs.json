{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Hypermid",
  "styling": {
    "codeblocks": "system"
  },
  "styles": ["style.css"],
  "colors": {
    "primary": "#3fadf2",
    "light": "#3fadf2",
    "dark": "#3fadf2"
  },
  "logo": {
    "light": "/branding/wordmark-light.svg",
    "dark": "/branding/wordmark-dark.svg",
    "href": "https://hypermid.io",
    "width": 400
  },
  "favicon": "/branding/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "light": "#F9F8F5",
    "dark": "#0A0A0A",
    "color": {
      "light": "#3fadf2",
      "dark": "#3fadf2"
    }
  },
  "navbar": {
    "links": [
      { "label": "API Status", "href": "https://api.hypermid.io/v1/ping" }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://partner.hypermid.io/login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "quickstart", "authentication", "response-format"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/cross-chain-swap",
              "guides/batched-approval",
              "guides/superswap",
              "guides/safety-fallback",
              "guides/fiat-onramp",
              "guides/error-handling",
              "guides/webhooks"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/chains",
              "resources/error-codes",
              "resources/changelog",
              "resources/support"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview"]
          },
          {
            "group": "Discovery",
            "pages": [
              "api-reference/chains",
              "api-reference/tokens",
              "api-reference/connections",
              "api-reference/tools",
              "api-reference/gas-prices",
              "api-reference/balances",
              "api-reference/swaps-by-wallet",
              "api-reference/superswap-reachable"
            ]
          },
          {
            "group": "Swap",
            "pages": [
              "api-reference/quote",
              "api-reference/routes",
              "api-reference/execute",
              "api-reference/register-inbound-receiver",
              "api-reference/status",
              "api-reference/deposit-submit",
              "api-reference/deposit-status"
            ]
          },
          {
            "group": "On-Ramp",
            "pages": [
              "api-reference/onramp-quote",
              "api-reference/onramp-checkout",
              "api-reference/onramp-status",
              "api-reference/onramp-config",
              "api-reference/onramp-assets"
            ]
          },
          {
            "group": "Partner",
            "pages": [
              "api-reference/partner-me",
              "api-reference/partner-stats",
              "api-reference/partner-transactions",
              "api-reference/partner-earnings",
              "api-reference/partner-fee-wallets",
              "api-reference/partner-active-promotions",
              "api-reference/webhooks-create",
              "api-reference/webhooks-list",
              "api-reference/webhooks-delete",
              "api-reference/swap-event"
            ]
          },
          {
            "group": "System",
            "pages": ["api-reference/ping"]
          }
        ]
      },
      {
        "tab": "Widget Integration",
        "icon": "browser",
        "groups": [
          {
            "group": "Widget Integration",
            "pages": [
              "widget/overview",
              "guides/widget-integration",
              "widget/playground",
              "widget/configuration",
              "widget/events",
              "widget/react"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "code",
        "pages": ["sdks/overview", "sdks/typescript", "sdks/python", "sdks/go", "sdks/rust"]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hypermid"
    }
  },
  "api": {
    "baseUrl": "https://api.hypermid.io",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    },
    "playground": {
      "display": "interactive"
    },
    "openapi": "https://api.hypermid.io/v1/openapi.json"
  },
  "description": "Cross-chain swap, bridge & fiat on-ramp SDK across 90+ chains (EVM, Solana, Bitcoin, NEAR, Sui, Tron, TON). TypeScript, Python, Go, Rust. Anonymous tier — no API key required.",
  "seo": {
    "indexing": "navigable"
  },
  "metadata": {
    "og:type": "website",
    "og:site_name": "Hypermid",
    "og:title": "Hypermid — Cross-chain swap, bridge & on-ramp SDK",
    "og:description": "One SDK for 90+ chains across EVM, Solana, Bitcoin, NEAR, Sui, Tron, TON. Anonymous tier — no API key required.",
    "og:url": "https://docs.hypermid.io",
    "og:image": "https://docs.hypermid.io/og-image.png",
    "og:image:width": "1200",
    "og:image:height": "630",
    "og:image:alt": "Hypermid — cross-chain swap, bridge and fiat on-ramp SDK, 90+ chains",
    "twitter:card": "summary_large_image",
    "twitter:site": "@hypermid",
    "twitter:title": "Hypermid — Cross-chain swap, bridge & on-ramp SDK",
    "twitter:description": "One SDK for 90+ chains. TypeScript, Python, Go, Rust. Anonymous tier — no API key required.",
    "twitter:image": "https://docs.hypermid.io/og-image.png",
    "twitter:image:alt": "Hypermid — cross-chain swap, bridge and fiat on-ramp SDK, 90+ chains"
  }
}
